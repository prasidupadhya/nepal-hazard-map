{
  "name": "nepal-hazard-map",
  "version": "1.0.0",
  "private": true,
  "description": "Flood, glacial lake outburst and earthquake map of Nepal: daily official data on a 3D map, what-if scenarios, English and Nepali.",
  "license": "MIT",
  "author": "Prasid (https://github.com/prasidupadhya)",
  "homepage": "https://nepal-hazard-map.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prasidupadhya/nepal-hazard-map.git"
  },
  "bugs": {
    "url": "https://github.com/prasidupadhya/nepal-hazard-map/issues"
  },
  "keywords": [
    "nepal",
    "flood",
    "glof",
    "glacial-lake",
    "earthquake",
    "hazard-map",
    "threejs",
    "webassembly",
    "disaster-risk"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "fetch": "node scripts/fetch-data.js",
    "wasm": "cd wasm && cargo build --release --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/scenario.wasm ../public/wasm/"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@fontsource-variable/anek-latin": "^5.3.0",
    "@types/three": "^0.170.0",
    "geotiff": "^2.1.3",
    "pngjs": "^7.0.0",
    "proj4": "^2.12.1",
    "sharp": "^0.33.5",
    "topojson-client": "^3.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^5.1.1",
    "world-atlas": "^2.0.2"
  }
}
